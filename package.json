{
	"name": "@ssecd/jkn",
	"displayName": "JKN",
	"version": "0.9.2",
	"description": "JKN (BPJS) Bridging API untuk NodeJS",
	"repository": {
		"type": "git",
		"url": "https://github.com/ssecd/jkn"
	},
	"homepage": "https://github.com/ssecd/jkn",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"scripts": {
		"test": "node --env-file=.env ./node_modules/vitest/vitest.mjs",
		"build": "tsc && dts-buddy dist/index.d.ts -m @ssecd/jkn:src/index.js && npm run build:copy-web",
		"build:copy-web": "node -e \"const fs=require('fs');const path=require('path');['index.html','login.html','config.html','app.js','styles.css','config.db','license.db'].forEach(f=>{const src=path.join('web',f);const dst=path.join('dist','web',f);if(fs.existsSync(src)){fs.copyFileSync(src,dst);console.log('Copied',f);}})\"",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"release": "changeset publish",
		"ui": "tsx web/server.ts",
		"ui:dev": "tsx watch web/server.ts",
		"install:ui": "npm install express cors tsx @types/express --save-dev",
		"start": "tsx web/server.ts",
		"start:prod": "node dist/web/server.js"
	},
	"keywords": [
		"jkn",
		"bpjs",
		"bridging",
		"vclaim",
		"antrean",
		"mobile-jkn"
	],
	"author": {
		"name": "Habib Mustofa",
		"email": "hm.dev7@gmail.com",
		"url": "https://github.com/mustofa-id"
	},
	"license": "MIT",
	"files": [
		"dist"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"@eslint/eslintrc": "^3.3.3",
		"@eslint/js": "^9.39.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.21",
		"@types/node": "^22.19.2",
		"@typescript-eslint/eslint-plugin": "^8.49.0",
		"@typescript-eslint/parser": "^8.49.0",
		"dts-buddy": "^0.5.5",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^16.5.0",
		"prettier": "^3.7.4",
		"tsx": "^4.7.0",
		"typescript": "^5.7.3",
		"vitest": "^0.34.6"
	},
	"dependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/express-session": "^1.18.2",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^8.5.2",
		"cors": "^2.8.5",
		"express": "^4.18.2",
		"express-session": "^1.18.2",
		"lz-string": "^1.5.0"
	},
	"peerDependencies": {
		"@types/fhir": "^0.0.40"
	},
	"packageManager": "pnpm@9.15.3"
}
